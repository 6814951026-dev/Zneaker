{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix zneaker install && npm --prefix zneaker/client install --include=dev",
  "buildCommand": "npm --prefix zneaker/client run build",
  "outputDirectory": "zneaker/client/dist",
  "functions": {
    "api/[...path].js": {
      "includeFiles": "zneaker/server/src/**"
    }
  }
}
